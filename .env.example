# Copy to .env and adjust. Never commit .env.
ENV=development

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://uvh:uvh@localhost:55432/uvh
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
SESSION_SECRET=dev-only-secret-change-me-32-bytes-min
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MEDIA_ROOT=media-library
USER_QUOTA_BYTES=21474836480
RATE_LIMIT_BACKEND=memory
LOG_LEVEL=INFO

# --- Frontend ---
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_NAME=Universal Video Hub
NEXT_PUBLIC_FINDER_URL=http://localhost:3000
NEXT_PUBLIC_LIBRARY_URL=http://localhost:3001
